# Required Strava API credentials (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Refresh token with activity:read_all,activity:write scopes
# Generate via: python setup_strava.py auth
STRAVA_REFRESH_TOKEN=your_refresh_token

# Arbitrary secret string used to verify Strava webhook subscription requests
STRAVA_VERIFY_TOKEN=change_me_to_a_random_secret

# Optional: Only process events for this Strava athlete ID (leave blank to allow any)
STRAVA_ATHLETE_ID=

# Set to "true" to log proposed activity updates without calling PUT on Strava
DRY_RUN=true
